# Workaround EasyPanel: servir con Node en lugar de nginx (mismo build)
# Si el contenedor deja de recibir SIGQUIT, el problema era el proxy/health check con nginx.
FROM node:20-alpine AS builder

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:20-alpine AS runner

WORKDIR /app
COPY --from=builder /app/dist ./dist
RUN npm install -g serve

EXPOSE 80
CMD ["serve", "-s", "dist", "-l", "80"]
